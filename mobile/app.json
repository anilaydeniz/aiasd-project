      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1A1D20"
      }
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "d90a84ca-63ba-4b83-893e-b0ea21763318"
      }
    },
    "owner": "anilaydeniz"
  }
